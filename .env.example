# ===========================================
# TEMPLATE KONFIGURASI - Copy ke .env lalu isi
# ===========================================

# Telegram Bot Credentials (for file sync)
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# Telegram Bot Credentials 2 (for JSON text backup)
VITE_TELEGRAM_BOT_TOKEN_2=your_second_bot_token_here
VITE_TELEGRAM_CHAT_ID_2=your_second_chat_id_here

# Google Apps Script URLs
VITE_GOOGLE_SHEETS_DAILY=https://script.google.com/macros/s/xxx/exec
VITE_GOOGLE_SHEETS_MONTHLY=https://script.google.com/macros/s/xxx/exec
VITE_GOOGLE_SHEETS_PRODUCTS=https://script.google.com/macros/s/xxx/exec
